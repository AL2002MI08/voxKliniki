# Database
DATABASE_URL=postgresql://postgres:postgres@localhost/hospvoice_dev

# JWT
JWT_SECRET=your_jwt_secret_here_change_in_production

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=

# LocalAI (OpenAI-compatible)
LOCALAI_BASE_URL=http://localhost:8080/v1
LOCALAI_API_KEY=localai
LOCALAI_CHAT_MODEL=llama-3.1-8b-instruct
LOCALAI_EMBED_MODEL=text-embedding-3-small

# Twilio
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# Digital Umuganda TTS (Kinyarwanda)
DIGITAL_UMUGANDA_API_KEY=...

# Server
PORT=4000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# ASR (Python microservice)
ASR_BASE_URL=http://localhost:8001

# TTS (Python microservice — Kinyarwanda)
TTS_BASE_URL=http://localhost:8002
